# Copy to .env.local for local development. Never commit real values.

# ── MongoDB Atlas (required) ────────────────────────────────────────────────
# Atlas → Connect → Drivers. The database name is set separately below.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=deepretain
# Name of the Atlas Vector Search index created by `npm run db:vector-index`
ATLAS_VECTOR_INDEX=concept_embedding_index

# ── Gemma via Ollama (optional; used when a learner has no AI key) ──────────
# Local: `ollama pull gemma2:9b` (or gemma2:2b) and `ollama pull all-minilm`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
# 384-dim embedding model for Atlas Vector Search
OLLAMA_EMBED_MODEL=all-minilm

# ── Hosted model (Google AI Studio) ─────────────────────────────────────────
# There is no server-wide key. Each signed-in learner pastes their own free key
# from https://aistudio.google.com/api-keys on the "AI key" tab; it is encrypted
# with AES-256-GCM before it is stored in their Auth0 app_metadata.
# Optional: pin one model instead of gemini-3.5-flash-lite (falls back to gemini-3.1-flash-lite).
GOOGLE_AI_MODEL=

# ── Auth0 (optional; without it the app runs in Demo Mode, sample decks only) ─
# Create a "Regular Web Application". Allowed Callback URL: <APP_BASE_URL>/auth/callback
# Allowed Logout URL: <APP_BASE_URL>
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32. Also derives the key that encrypts learners' AI keys,
# so rotating it means learners have to save their key again.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Saving AI keys uses the Auth0 Management API. Authorize the app above for it with the
# read:users and update:users_app_metadata scopes, or set a separate M2M app here.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Only needed when AUTH0_DOMAIN is a custom domain: your tenant's <name>.<region>.auth0.com domain.
AUTH0_MANAGEMENT_DOMAIN=

# ── Pacing & judge access ───────────────────────────────────────────────────
# Lets judges try the app without an account (each browser gets an isolated demo learner)
DEMO_MODE_ENABLED=true
# Max micro-reviews per local day before the rest screen locks cramming
DAILY_COGNITIVE_CAP=15
